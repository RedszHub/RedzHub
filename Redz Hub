local function make(class, props, parentObj)
    local obj = Instance.new(class)
    for key, value in pairs(props) do
        obj[key] = value
    end
    obj.Parent = parentObj
    return obj
end

local function rounded(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, obj)
end

local function outlined(obj, thickness)
    make("UIStroke", {
        Color = red,
        Thickness = thickness
    }, obj)
end

